@if (Model.CategoryID != 0 && Model.CategoriesData.Books != null && !Model.CategoriesData.Books.Any())
{
    <p>No books available in this category.</p>
}
else if (Model.CategoriesData.Books != null && Model.CategoriesData.Books.Any())
{
    <h3>Books from Category</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.CategoriesData.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author.AuthorName</td>
                </tr>
            }
        </tbody>
    </table>
}

